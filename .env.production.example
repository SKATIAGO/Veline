# Copia esto a .env en el VPS (no en tu Mac) y rellena los valores reales.
# Este archivo .env.production.example SÍ se sube al repo; el .env real
# (con contraseñas y claves) NUNCA — ya está en .gitignore.

# ── Dominio ──────────────────────────────────────────────────────
# El dominio ya tiene que resolver a la IP de este VPS antes de arrancar,
# si no Caddy no consigue pedir el certificado. Ver docs/09-despliegue.md.
DOMAIN=veline.es
PUBLIC_WEB_URL=https://veline.es
# Contacto que usa Let's Encrypt para avisos sobre los certificados.
ACME_EMAIL=tu-email@veline.es

# ── Base de datos ────────────────────────────────────────────────
POSTGRES_USER=veline
# Genera una contraseña fuerte, por ejemplo con: openssl rand -hex 24
# (hex, no base64: base64 puede meter /, + o = y esos caracteres rompen
# la URL de conexión de Prisma sin escapar — ver docs/09-despliegue.md)
POSTGRES_PASSWORD=
POSTGRES_DB=veline

# ── Correo — ver docs/08-correo.md ───────────────────────────────
# Qué proveedor manda el correo. PONLO SIEMPRE, aunque parezca obvio: si
# falta, docker-compose.prod.yml pone «acumbamail», y como el token de
# Acumbamail hace falta para los SMS, el correo también se iría por ahí.
MAIL_PROVIDER=brevo
# Sigue en modo dry hasta que el dominio de envío esté verificado.
# Pasar a "live" antes de eso hace que los correos salgan desde un remitente
# sin verificar y es fácil que acaben en spam.
MAIL_MODE=dry
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Veline
MAIL_OVERRIDE_TO=

# ── SMS (Acumbamail) — ver docs/08-correo.md ────────────────────
# Tres SMS al cliente: al reservar, 24 h antes de la cita y al cancelar.
# live = se envían de verdad y se cobran · dry = se registran pero NO salen.
# Sin esta línea, producción se queda en dry y no sale ninguno.
SMS_MODE=live
# Panel de Acumbamail → API. Sin token no sale ninguno aunque esté en live.
ACUMBAMAIL_TOKEN=
# Remitente: letras y números, 11 caracteres como mucho.
SMS_SENDER=Veline
# Si se rellena, TODOS los SMS van a este número. En producción, vacío.
SMS_OVERRIDE_TO=

# ── Superadmin inicial ──────────────────────────────────────────
# El seed crea esta cuenta si no existe. Genera la contraseña en el propio
# servidor (openssl rand -base64 18) y, tras el primer arranque, puedes
# retirar estas dos líneas: la cuenta ya queda en la base de datos.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

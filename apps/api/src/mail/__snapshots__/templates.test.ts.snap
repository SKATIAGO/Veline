      <td style="padding:11px 0 0;font-size:13px;color:#2E2119;font-weight:600;text-align:right;">Martes 15 de septiembre a las 12:00</td>
    </tr><tr>
      <td style="padding:11px 0 0;font-size:13px;color:#8A7255;">Asignada a</td>
      <td style="padding:11px 0 0;font-size:13px;color:#2E2119;font-weight:600;text-align:right;">&lt;img src=x onerror=&quot;alert(1)&quot;&gt;Marta</td>
    </tr><tr>
      <td style="padding:11px 0 0;font-size:13px;color:#8A7255;">Cliente</td>
      <td style="padding:11px 0 0;font-size:13px;color:#2E2119;font-weight:600;text-align:right;">&lt;img src=x onerror=&quot;alert(1)&quot;&gt;Marina</td>
    </tr><tr>
      <td style="padding:11px 0 0;font-size:13px;color:#8A7255;">Teléfono</td>
      <td style="padding:11px 0 0;font-size:13px;color:#2E2119;font-weight:600;text-align:right;">612345678</td>
    </tr><tr>
      <td style="padding:11px 0 0;font-size:13px;color:#8A7255;">Email</td>
      <td style="padding:11px 0 0;font-size:13px;color:#2E2119;font-weight:600;text-align:right;">marina@ejemplo.es</td>
    </tr><tr>
      <td style="padding:11px 0 0;font-size:13px;color:#8A7255;">Importe</td>
      <td style="padding:11px 0 0;font-size:13px;color:#2E2119;font-weight:600;text-align:right;">25,00 €</td>
    </tr><tr>
      <td style="padding:11px 0 0;font-size:13px;color:#8A7255;">Código</td>
      <td style="padding:11px 0 0;font-size:13px;color:#2E2119;font-weight:600;text-align:right;">VL-TEST</td>
    </tr>
  </table><p style="margin:20px 0 0;padding:14px 16px;background:#F2E7D6;border-radius:10px;font-size:13.5px;line-height:1.6;color:#4A3826;"><strong>Nota del cliente:</strong> &lt;script&gt;robar()&lt;/script&gt;</p><p style="margin:18px 0 0;font-size:13px;color:#8A7255;">

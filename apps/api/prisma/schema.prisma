// Veline — modelo de datos
// Mercado España: importes en céntimos de euro, horarios en minutos desde
// medianoche (hora local de Europe/Madrid), fechas de cita en UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  GRATIS
  NEGOCIO
  EQUIPOS
}

/// En qué punto está la relación comercial con el negocio.
enum SubStatus {
  /// Dentro de los días de prueba. Funciona todo.
  PRUEBA
  /// Al día de pago.
  ACTIVA
  /// Se le ha pasado el cobro. Sigue funcionando: primero se avisa.
  IMPAGADA
  /// Cortado a mano. Deja de aceptar reservas nuevas.
  SUSPENDIDA
  /// Se dio de baja él. Igual que suspendida pero por decisión suya.
  CANCELADA
}

enum BookingStatus {
  CONFIRMADA
  CANCELADA
  COMPLETADA
  /// El cliente no apareció. Se separa de CANCELADA porque no es lo mismo
  /// para el negocio: una cancelación libera el hueco a tiempo, una ausencia
  /// se lo come. Y de esto salen los avisos de clientes poco fiables.
  NO_ASISTIO
}

/// De dónde viene la reserva. Determina si se cobra la comisión del 15%.
enum BookingSource {
  MARKETPLACE
  DIRECTO
  INSTAGRAM
  GOOGLE
}

model Business {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// slug de CATEGORIES en @veline/shared
  category    String
  description String?
  phone       String?
  /// Dónde se avisa al negocio de las citas nuevas y las cancelaciones.
  email       String?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  plan        Plan     @default(GRATIS)

  // ── Suscripción ──
  /// El plan por sí solo no dice nada: hace falta saber si está pagando, en
  /// prueba o cortado. Sin esto la prueba de 15 días no tenía ni fecha.
  subStatus   SubStatus @default(PRUEBA)
  trialEndsAt DateTime?
  /// Cuándo se le cortó o se dio de baja, para poder contarlo después.
  endedAt     DateTime?
  /// Nota interna de la ficha: por qué se suspendió, con quién se habló.
  adminNotes  String?
  /// URLs base de las fotos (sin parámetros de tamaño). La primera es la
  /// portada; el resto rellena la galería del perfil.
  photos      String[]
  createdAt   DateTime @default(now())

  locations Location[]
  services  Service[]
  staff     Staff[]
  bookings  Booking[]
  users     User[]
  auditLogs AuditLog[]
  messages  MessageLog[]
  charges   Charge[]
  reviews   Review[]

  @@index([category])
}

model Location {
  id         String @id @default(cuid())
  businessId String
  name       String @default("Principal")
  street     String
  city       String
  postalCode String
  lat        Float?
  lng        Float?

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  openingHours OpeningHour[]
  closures     Closure[]
  staff        Staff[]
  bookings     Booking[]

  @@index([businessId])
  @@index([city])
}

model Service {
  id          String  @id @default(cuid())
  businessId  String
  name        String
  description String?
  /// Duración de la cita en minutos
  durationMin Int
  /// Margen posterior reservado para el negocio (limpieza, papeleo…)
  bufferMin   Int     @default(0)
  priceCents  Int
  active      Boolean @default(true)
  position    Int     @default(0)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([businessId])
}

/// Persona o recurso que atiende. El límite por plan (1 / 3 / ilimitado) se
/// aplica sobre esta tabla.
model Staff {
  id         String  @id @default(cuid())
  businessId String
  locationId String?
  name       String
  active     Boolean @default(true)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([businessId])
}

/// Horario de atención semanal. Varias franjas por día = varias filas
/// (p. ej. mañana y tarde con cierre al mediodía).
model OpeningHour {
  id         String @id @default(cuid())
  locationId String
  /// 0 = domingo … 6 = sábado (igual que Date#getDay)
  weekday    Int
  /// Minutos desde medianoche, hora local
  startMin   Int
  endMin     Int

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, weekday])
}

/// Excepción puntual: festivo, vacaciones o cierre parcial de un día.
model Closure {
  id         String   @id @default(cuid())
  locationId String
  date       DateTime @db.Date
  /// null = el día entero
  startMin   Int?
  endMin     Int?
  reason     String?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, date])
}

/// Cliente que reserva. Sin cuenta: se identifica por teléfono.
/// Cuando entre el login con Apple/Google se le añade authProvider + authSubject.
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())

  bookings Booking[]
  reviews  Review[]
}

model Booking {
  id         String        @id @default(cuid())
  /// Código legible que se le da al cliente: VL-7F3K2
  code       String        @unique
  businessId String
  locationId String?
  serviceId  String
  staffId    String?
  customerId String
  startsAt   DateTime
  endsAt     DateTime
  /// Fin real ocupado en agenda = endsAt + buffer del servicio
  blockedTo  DateTime
  status     BookingStatus @default(CONFIRMADA)
  priceCents Int
  notes      String?

  // ── Atribución: de esto depende la comisión del 15% ──
  source                 BookingSource @default(MARKETPLACE)
  /// true solo la primera vez que este cliente reserva en este negocio vía marketplace
  isFirstFromMarketplace Boolean       @default(false)
  commissionCents        Int           @default(0)

  createdAt   DateTime  @default(now())
  cancelledAt DateTime?
  /// Sella el recordatorio para no mandarlo dos veces si el proceso repite.
  reminderSentAt DateTime?

  messages MessageLog[]
  review   Review?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  service  Service   @relation(fields: [serviceId], references: [id])
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  customer Customer  @relation(fields: [customerId], references: [id])

  /// El solapamiento se valida en una transacción SERIALIZABLE: Postgres
  /// detecta el write-skew de dos reservas simultáneas sobre el mismo hueco y
  /// aborta una. No usamos un índice único [staffId, startsAt] porque dejaría
  /// el hueco bloqueado después de cancelar.
  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId])
}

/// Quién puede entrar al panel y con qué alcance.
enum Role {
  /// Personal de Veline: gestiona la plataforma entera.
  SUPERADMIN
  /// Dueño del negocio: su negocio completo, incluidos sus usuarios.
  ADMIN
  /// Persona del equipo: la agenda de su negocio, sin configuración.
  EMPLEADO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// scrypt con sal propia, formato "sal:hash" en hex. Nunca la contraseña.
  passwordHash String
  role         Role
  /// null solo para SUPERADMIN: no pertenece a ningún negocio.
  businessId   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  business       Business?       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions       Session[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]

  @@index([businessId])
}

/// Sesión de panel. Se guarda el hash del token, no el token: si alguien
/// llegara a leer la tabla, no puede suplantar a nadie.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Petición de restablecimiento de contraseña. Igual que las sesiones, se
/// guarda el hash del token y no el token: quien leyera la tabla no podría
/// usarlo para entrar en ninguna cuenta.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  /// Sella el momento de uso: un enlace solo sirve una vez.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Una reseña de verdad, escrita por quien tuvo la cita.
///
/// Antes la estrella del marketplace era un número fijo escrito en los datos
/// de ejemplo: 4,8 con 126 reseñas que nunca escribió nadie. Ahora sale de
/// aquí, y un negocio nuevo empieza sin estrella en vez de con una inventada.
///
/// Solo se puede reseñar una cita COMPLETADA, y una sola vez: el enlace lleva
/// un testigo que se consume. Sin eso, cualquiera podría inflar la nota de un
/// negocio desde fuera.
model Review {
  id         String   @id @default(cuid())
  businessId String
  /// Una cita, una reseña.
  bookingId  String   @unique
  customerId String
  /// De 1 a 5.
  rating     Int
  comment    String?
  /// Testigo del enlace que se le manda al cliente. Se guarda el hash, no el
  /// testigo: igual que las sesiones y los restablecimientos de contraseña.
  tokenHash  String   @unique
  /// Null mientras no la haya escrito: la fila nace al pedirla.
  answeredAt DateTime?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, answeredAt])
}

enum ChargeStatus {
  /// Generado, esperando el pago.
  PENDIENTE
  /// Marcado como cobrado a mano (transferencia, recibo…).
  COBRADO
  /// Se decidió no cobrarlo: cortesía, error, negocio dado de baja.
  ANULADO
}

/// Lo que le toca pagar a un negocio por un mes.
///
/// Se genera al cerrar el mes con las cifras congeladas: si después cambia de
/// plan o da de baja a alguien, el mes ya cerrado no se mueve. Cobrar hacia
/// atrás con la tarifa nueva sería una sorpresa desagradable.
///
/// El cobro es MANUAL por ahora (transferencia o recibo): no hay pasarela.
/// Esta tabla es el registro de qué se debe y qué está pagado.
model Charge {
  id         String       @id @default(cuid())
  businessId String
  /// Mes que se cobra, siempre el día 1: 2026-09-01 = septiembre.
  period     DateTime     @db.Date
  status     ChargeStatus @default(PENDIENTE)

  // ── Desglose, congelado al generar ──
  plan            Plan
  /// Personas activas en el momento de cerrar el mes.
  seats           Int
  /// Cuota del plan más las personas de más.
  subscriptionCents Int
  /// 15 % de los primeros clientes que llegaron por el marketplace.
  commissionCents Int
  /// Mensajes fuera del cupo, a 0,06 €.
  messagesCents   Int
  extraMessages   Int
  totalCents      Int

  /// Cuándo y quién lo marcó cobrado, y por qué vía.
  paidAt   DateTime?
  paidNote String?

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Un negocio tiene como mucho un cobro por mes.
  @@unique([businessId, period])
  @@index([status, period])
}

/// Por dónde sale un mensaje.
enum MessageChannel {
  EMAIL
  SMS
}

/// Para qué se manda. Sirve para contar y para no repetir envíos.
enum MessageKind {
  RESERVA_CONFIRMADA
  RESERVA_CANCELADA
  RECORDATORIO
  RESTABLECER_CONTRASENA
  RESENA_PEDIDA
}

enum MessageStatus {
  ENVIADO
  FALLIDO
  /// No se intentó: modo de pruebas, dirección no entregable, sin cupo…
  OMITIDO
}

/// Cada mensaje que sale (o se intenta) desde Veline.
///
/// Existe por dos motivos que no se pueden resolver mirando el log del
/// servidor: saber cuántos mensajes lleva un negocio este mes —de eso depende
/// lo que se le cobra a partir del 201— y poder responder "¿le llegó el
/// recordatorio a este cliente?" tres semanas después.
model MessageLog {
  id         String        @id @default(cuid())
  businessId String?
  bookingId  String?
  channel    MessageChannel
  kind       MessageKind
  /// Email o teléfono. Es dato personal: no se enseña fuera del panel.
  to         String
  status     MessageStatus
  /// Por qué falló o por qué se omitió.
  reason     String?
  /// Lo que cuesta al negocio. 0 mientras entre en el cupo del plan.
  costCents  Int           @default(0)
  createdAt  DateTime      @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([bookingId])
}

/// Qué se registra. Nombres estables: se guardan en la base y se muestran en
/// el panel, así que renombrar uno reescribe el pasado.
enum AuditAction {
  SESION_INICIADA
  SESION_FALLIDA
  SESION_CERRADA
  CONTRASENA_CAMBIADA
  CONTRASENA_RESTABLECIDA
  CONTRASENA_OLVIDADA
  USUARIO_CREADO
  USUARIO_ACTIVADO
  USUARIO_DESACTIVADO
  NEGOCIO_CREADO
  NEGOCIO_PLAN_CAMBIADO
  NEGOCIO_SUSPENDIDO
  NEGOCIO_REACTIVADO
  PRUEBA_AMPLIADA
  COBRO_GENERADO
  COBRO_MARCADO
  RESENA_PUBLICADA
  SERVICIO_CREADO
  SERVICIO_EDITADO
  SERVICIO_ELIMINADO
  HORARIO_EDITADO
  RESERVA_CREADA
  RESERVA_CANCELADA
  RESERVA_MOVIDA
  RESERVA_COMPLETADA
  RESERVA_NO_ASISTIO
  PERSONA_CREADA
  PERSONA_EDITADA
  PERSONA_DESACTIVADA
  PERSONA_ACTIVADA
  CIERRE_CREADO
  CIERRE_ELIMINADO
  NEGOCIO_EDITADO
}

/// Registro de auditoría: quién hizo qué, cuándo y desde dónde.
///
/// Es solo de escritura y lectura. No hay endpoint que lo edite ni lo borre:
/// un registro que el propio sistema puede reescribir no sirve para lo que
/// existe, que es poder responder "¿quién canceló esta cita?" meses después.
model AuditLog {
  id String @id @default(cuid())

  action AuditAction

  /// Quién. Nulo cuando lo hace un cliente sin cuenta (reservar, cancelar con
  /// su código) o cuando el intento de sesión falla y no hay usuario.
  actorId    String?
  /// Copia del email y el nombre en el momento del hecho. Si el usuario se
  /// borra, el registro tiene que seguir diciendo quién fue.
  actorEmail String?
  actorName  String?
  actorRole  Role?

  /// A qué negocio afecta. Nulo en acciones de plataforma.
  businessId String?

  /// Sobre qué se actuó: "Booking", "Service", "User"… y su id.
  entity   String?
  entityId String?

  /// Frase en español ya montada, lista para leer en el panel.
  summary String

  /// Detalle libre: valores antes y después, motivo de cancelación… Nunca
  /// contraseñas ni tokens (ver redactar() en audit.ts).
  metadata Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

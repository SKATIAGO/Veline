# Copiar a .env — docker compose lo lee automáticamente.
POSTGRES_USER=veline
POSTGRES_PASSWORD=veline
POSTGRES_DB=veline

# Puertos expuestos en el host
WEB_PORT=5173
API_PORT=3001
DB_PORT=5432

# Exponer la web por ngrok (ver docs/07-ngrok.md).
# Con TUNNEL=true el HMR de Vite apunta a wss://<dominio>:443 en vez de :5173.
# TUNNEL=true
# ALLOWED_HOSTS=mi-dominio.ngrok-free.app

# Copiar a .env — docker compose lo lee automáticamente.
POSTGRES_USER=veline
POSTGRES_PASSWORD=veline
POSTGRES_DB=veline

# Puertos expuestos en el host
WEB_PORT=5173
API_PORT=3001
DB_PORT=5432

# ── Correo (Brevo) — ver docs/08-correo.md ──────────────────────────
# NUNCA pongas la clave real aquí: este archivo sí se sube al repo.
# BREVO_API_KEY=xkeysib-...
#
# off | dry | live      (por defecto dry: construye el correo y lo registra,
#                        pero no lo envía. Con la app en un túnel público es
#                        lo único seguro.)
MAIL_MODE=dry
# Debe ser un remitente verificado en Brevo, si no la API responde 400.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Veline
# Red de seguridad: manda TODO a esta dirección, sea quien sea el destinatario.
MAIL_OVERRIDE_TO=
# URL pública para los enlaces de los correos (la de ngrok cuando toque).
PUBLIC_WEB_URL=http://localhost:5173

# Exponer la web por ngrok (ver docs/07-ngrok.md).
# Con TUNNEL=true el HMR de Vite apunta a wss://<dominio>:443 en vez de :5173.
# TUNNEL=true
# ALLOWED_HOSTS=mi-dominio.ngrok-free.app

# ── SMS (Acumbamail) ──
SMS_MODE=dry                 # off | dry | live
ACUMBAMAIL_TOKEN=
SMS_SENDER=Veline            # alfanumérico, 11 caracteres como mucho
SMS_OVERRIDE_TO=             # manda TODO aquí, para probar sin escribir a nadie
